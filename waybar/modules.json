    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": true,
    "persistent-workspaces": {
	"1": [],
	"2": [],
	"3": [],
	"4": [],
	"5": [],
	"6": [],
	"7": [],
	"8": [],
	"9": []
    }
  },
  
  "hyprland/language": {
    "format": "⌨ {short}"   
  },

"clock": {
    "format": "  {:%H:%M}",
    "format-alt": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click": "mode"
  },

"cpu": {
    "format": "󰻠 {usage}%",
    "format-alt": "󰻠 {avg_frequency:.1f}GHz",
    "on-click": "mode",
    "interval": 2,
    "tooltip": false
  },

"temperature": {
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["󱃃", "󰔏", "󱃂"],
    "tooltip": false
  },

"memory": {
    "format": "󰍛 {used:.1f}G/{total:.1f}G",
    "tooltip": false
  },

  "network": {
    "format-wifi": "  {essid} {signalStrength}%",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰤭 offline",
    "tooltip-format-wifi": "{ipaddr} via {gwaddr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "interval": 5
  },

"disk": {
    "interval": 30,
    "format": "󰋊 {free}",
    "path": "/",
    "tooltip-format": "{path}: {used} used of {total} ({percentage_used}%)"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿 ", "󰖀 ", "󰕾 "]
    },
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}% ⚡",
    "format-time": "{H}h {M}m",
    "tooltip-format": "Time remaining: {time}",
    "interval": 30,
    "format-icons": {
      "default": ["󰁺","󰁻","󰁼","󰁽","󰁽","󰁿","󰂀","󰂁","󰂂","󰁹"],
      "charging": ["󰢜 ","󰂆 ","󰂇 ","󰂈 ","󰢝 ","󰂉 ","󰢞 ","󰂊 ","󰂋 ","󰂅 "]
    },
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "custom/weather": {
    "exec": "curl -s 'https://wttr.in/?format=%c+%t'",
    "interval": 1800,
    "format": "{}",
    "tooltip": false
  },

  "tray": {
    "spacing": 8,
    "icon-size": 16
  },

  "custom/media": {
    "format": "{icon} {}",
    "escape": true,
    "return-type": "json",
    "max-length": 35,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "smooth-scrolling-threshold": 10,
    "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null"
  },

}
