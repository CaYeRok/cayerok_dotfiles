  "hyprland/language": {
    "format": "⌨ {short}"   
  },

  "clock": {
    "format": "  {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": false
  },

  "memory": {
    "format": "RAM {percentage}%",
    "tooltip": false
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀",
    "format-disconnected": "⚠",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  {volume}%",
    "on-click": "pavucontrol"
  },

  "battery": {
    "format": "  {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "tray": {
    "spacing": 10
  }
}
